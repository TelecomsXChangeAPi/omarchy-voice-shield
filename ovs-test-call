#!/bin/bash
# Test-call control for the Omarchy bar widget.
#
#   ovs-test-call destinations   list the destinations a call can be sent to
#   ovs-test-call place          queue one   (OVS_NUMBER, OVS_SECONDS, OVS_SPEECH, OVS_DEST_ID)
#   ovs-test-call poll           check on it (OVS_TEST_ID)
#
# Each mode prints one JSON object and exits 0:
#   {"ok":true,"test":{...}} | {"ok":true,"destinations":[...]} | {"ok":false,"error":"…"}
#
# The dialled number arrives in the environment rather than in argv, and from
# there reaches jq and curl on stdin — as do the API's answers, which repeat it.
# /proc/PID/cmdline is world-readable and /proc/PID/environ is not, and the
# number somebody is calling is not something to hand to every other process
# on the machine. The API key is passed neither way — ovs-lib.sh reads it from
# the config file and hands it to curl through a pipe.

set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ovs-lib.sh"
ovs_load_config

# A JSON body plus the HTTP status from ovs_post, turned into the widget's
# result contract. 2xx carries the test call; anything else carries a reason
# worth putting on screen verbatim ("no destination configured" beats "409").
emit_test() {
  local raw="$1" code body msg
  code="${raw##*$'\n'}"
  body="${raw%$'\n'*}"

  [[ -n "$code" ]] || ovs_fail "unreachable"
  jq -e . <<<"$body" >/dev/null 2>&1 || ovs_fail "unreachable"

  case "$code" in
    2*) printf '%s' "$body" | jq -nc '{ok: true, test: input}' ;;
    *)
      msg=$(ovs_error_message "$body")
      ovs_fail "${msg:-http-$code}"
      ;;
  esac
}

case "${1:-}" in
  destinations)
    body=$(ovs_get "/customer/destinations")
    jq -e . <<<"$body" >/dev/null 2>&1 || ovs_fail "unreachable"
    printf '%s' "$body" | jq -nc '
      input as $d |
      if ($d | type) == "array" then { ok: true, destinations: $d }
      else { ok: false, error: (($d.detail? // $d.error? // "api-error") | tostring) }
      end
    '
    ;;

  place)
    number="${OVS_NUMBER:-}"
    # Same shape the API enforces, checked here so an unusable number costs a
    # round trip instead of a 422.
    [[ "$number" =~ ^\+?[0-9*#]{2,32}$ ]] || ovs_fail "bad-number"

    seconds="${OVS_SECONDS:-30}"
    [[ "$seconds" =~ ^[0-9]+$ ]] || seconds=30
    (( seconds < 5 )) && seconds=5
    (( seconds > 600 )) && seconds=600

    speech="${OVS_SPEECH:-route_test}"
    dest="${OVS_DEST_ID:-}"

    # destination_id is omitted rather than sent empty, which is what makes the
    # platform fall back to the account's default destination. The number is
    # jq's raw input, not an --arg, which would put it straight back into argv.
    payload=$(printf '%s' "$number" | jq -Rsc \
      --argjson s "$seconds" \
      --arg sp "$speech" \
      --arg d "$dest" '
      { number: ., seconds: $s, speech: $sp }
      + (if $d == "" then {} else { destination_id: $d } end)
    ')

    emit_test "$(ovs_post "/customer/test-calls" "$payload")"
    ;;

  poll)
    id="${OVS_TEST_ID:-}"
    # Constrained to a UUID before it is pasted into a URL path.
    [[ "$id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
      || ovs_fail "no-test-id"

    body=$(ovs_get "/customer/test-calls/$id")
    jq -e . <<<"$body" >/dev/null 2>&1 || ovs_fail "unreachable"
    printf '%s' "$body" | jq -nc '
      input as $t |
      if ($t | type) == "object" and $t.id != null then { ok: true, test: $t }
      else { ok: false, error: (($t.detail? // $t.error? // "api-error") | tostring) }
      end
    '
    ;;

  *)
    ovs_fail "bad-mode"
    ;;
esac
