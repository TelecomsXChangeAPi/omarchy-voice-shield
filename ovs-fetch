#!/bin/bash
# One combined Open Voice Shield snapshot for the Omarchy bar widget.
#
# Emits a single JSON object on stdout and always exits 0, so the widget
# renders an error state instead of a QML process failure:
#   {"ok":true,  "dashboard":{...}, "live":{...}}
#   {"ok":false, "error":"no-key"}
#
# Config, auth and the HTTP helpers live in ovs-lib.sh, shared with
# ovs-test-call. Neither the API key nor any response data is passed in argv,
# so none of it shows up in the process table.

set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ovs-lib.sh"
ovs_load_config

dash=$(ovs_get "/customer/dashboard?days=$days")
jq -e . <<<"$dash" >/dev/null 2>&1 || ovs_fail "unreachable"

# Live calls are optional: anything that is not recognisably a live-calls
# payload — including the rejection object a too-large response produces — is
# dropped rather than passed through as if it were one.
live=$(ovs_get "/customer/live-calls")
jq -e 'type == "object" and (has("items") or has("active_count"))' \
  <<<"$live" >/dev/null 2>&1 || live="null"

# Both bodies reach jq on stdin rather than as --argjson arguments: they carry
# call data, which has no place in a world-readable argv, and Linux caps a
# single argument at 128 KiB, half of what OVS_MAX_BYTES admits.
printf '%s\n%s\n' "$dash" "$live" | jq -nc '
  input as $d | input as $l |
  if ($d | type) == "object" and $d.calls_today != null then
    { ok: true, dashboard: $d, live: (if ($l | type) == "object" then $l else null end) }
  else
    { ok: false, error: (($d.detail? // $d.error? // "api-error") | tostring) }
  end
'
